# Savanty Environment Configuration
# Copy this file to .env and fill in your values

# Required
# Your OpenAI API key for LLM access
OPENAI_API_KEY=your_api_key_here

# Optional - LLM Configuration
# The LLM model to use (default: openai/gpt-4o)
# SAVANTY_LLM_MODEL=openai/gpt-4o

# Optional - Server Configuration
# Port for the web server (default: 8000)
# SAVANTY_PORT=8000

# Environment mode: development or production (default: development)
# SAVANTY_ENV=development

# CORS origins (comma-separated, required in production)
# SAVANTY_CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional - Request Limits
# Maximum length of problem description (default: 10000)
# SAVANTY_MAX_PROBLEM_LENGTH=10000

# Maximum length of additional info (default: 5000)
# SAVANTY_MAX_ADDITIONAL_INFO_LENGTH=5000

# Timeout in seconds for solving (default: 120)
# SAVANTY_SOLVE_TIMEOUT=120

# Optional - Logging
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# SAVANTY_LOG_LEVEL=INFO

# Log format (default: %(asctime)s - %(name)s - %(levelname)s - %(message)s)
# SAVANTY_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
